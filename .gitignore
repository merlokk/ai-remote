# Python
__pycache__/
*.py[cod]

# Virtualenv
.venv/

# pytest
.pytest_cache/
.pytest_tmp/

# Rust build output (the status line binary, §9)
statusline/target/

# The status line's runtime config (§9.9). It lives next to the executable, so
# `statusline/target/` above already covers the default location — this catches
# a binary copied elsewhere in the tree. It holds no secrets; it is per-machine.
# (`statusline-config.example.json` in the root carries the defaults and IS committed.)
statusline-config.json

# Claude Code, the per-machine half. Permissions granted on this machine and the
# absolute path to the PermissionRequest hook's interpreter — nothing another
# checkout can use. (`.claude/settings.json` is project-wide and IS committed:
# it wires the status line and the three PreToolUse/PostToolUse/Stop hooks that
# publish the `activity` subject, §9.5 and §9.10.)
#
# **Unanchored, because a session started inside a subfolder makes that folder
# the project root** and Claude Code writes a `.claude/` there too — the pattern
# with a leading path would have covered only this directory's.
**/.claude/settings.local.json

# IDE
.idea/

# A working scratchpad in the repository root. Personal, not part of the project.
/notes.txt

# Responder / handler runtime configs — hold secrets (Ed25519 private key,
# live token secrets in pending_tokens). Never commit.
# (The *.example.json siblings carry no secrets and ARE committed.)
approver/responder-config.json
approver/handler-config.json

# YubiKey responder config. Holds no private key (the ARKG private half never leaves
# the device), but it identifies a credential and links the derived key to it.
approver/responder-yubikey-config.json

# Saved yubikey-exec credentials (`make-credential --out`). No private key material
# — the ARKG private halves never leave the device — but they identify a credential,
# and the docs use these names as examples, so keep them out of commits by default.
/cred.json
*-cred.json
